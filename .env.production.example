# ================================================================
# Innonet Production Environment
# Copy to .env.production and fill in every value.
#
# This file is used for BOTH:
#   - Docker Compose variable substitution (${VAR} in compose file)
#   - Backend container environment (via env_file in compose)
#
# Run with:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ================================================================

# ── Server / TLS (Caddy) ────────────────────────────────────────
DOMAIN=yourdomain.com
ACME_EMAIL=you@example.com

# ── API URL (baked into frontend at build time) ──────────────────
# Relative path is correct — Caddy proxies /api/* to backend
VITE_API_URL=/api/v1

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_USER=innonet
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=innonet
DATABASE_URL=postgresql+asyncpg://innonet:CHANGE_ME_strong_postgres_password@postgres:5432/innonet
DB_SSL_MODE=prefer

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379/0

# ── Neo4j ────────────────────────────────────────────────────────
NEO4J_PASSWORD=CHANGE_ME_strong_neo4j_password
NEO4J_URI=bolt://neo4j:7687

# ── JWT ─────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME

# ── Field-Level Encryption ───────────────────────────────────────
# Generate key:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate hash: openssl rand -hex 32
ENCRYPTION_KEY_V1=CHANGE_ME_fernet_key
ENCRYPTION_LOOKUP_HASH_KEY=CHANGE_ME_64_char_hex
ENCRYPTION_CURRENT_VERSION=1

# ── Application ──────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
FRONTEND_URL=https://yourdomain.com

# ── Optional integrations ────────────────────────────────────────
OPENAI_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
