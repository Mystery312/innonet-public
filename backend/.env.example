# Development Environment Configuration Template
# Copy this file to .env and replace with actual values
# NEVER commit .env file to git!

# Security - Generate using: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your-secret-key-here-min-512-bits

# Data Encryption at Rest (field-level, versioned key-ring)
# Generate a Fernet key with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Populate at least ENCRYPTION_KEY_V1 in new deployments. The legacy
# ENCRYPTION_KEY env var below is treated as v1 for back-compat.
ENCRYPTION_KEY_V1=your-fernet-key-v1-here
# ENCRYPTION_KEY_V2=   # set during a key rotation window
# ENCRYPTION_KEY_V3=
ENCRYPTION_CURRENT_VERSION=1
# Separate HMAC key for deterministic lookup hashes on encrypted columns
# (blind index for login email/phone). Generate with:  openssl rand -hex 32
ENCRYPTION_LOOKUP_HASH_KEY=your-hmac-key-hex-64-chars

# Database Configuration - Choose ONE of these approaches:
#
# OPTION 1: Connection Strings (simple, traditional)
# Use "localhost" here — start.sh runs the backend on the host via uvicorn,
# not inside Docker, while Postgres/Redis/Neo4j run in docker-compose with
# their ports mapped to localhost. Only use the "postgres"/"redis"/"neo4j"
# service-name hostnames if the backend itself is also running inside the
# docker-compose network (e.g. docker-compose.prod.yml).
DATABASE_URL=postgresql+asyncpg://postgres:your-password-here@localhost:5432/innonet
REDIS_URL=redis://:your-password-here@localhost:6379/0

# Database TLS (Alibaba RDS / production-grade Postgres).
# Modes: disable | prefer | require | verify-ca | verify-full
# Dev default: prefer. Prod should use require or verify-full.
DB_SSL_MODE=prefer
# DB_SSL_ROOT_CERT=/etc/ssl/certs/ApsaraDB-CA-Chain.pem
#
# OPTION 2: Individual Variables (recommended for production/secret managers)
# If you prefer individual variables, comment out DATABASE_URL and REDIS_URL above
# and uncomment these:
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=innonet
# DB_USER=postgres
# DB_PASSWORD=your-password-here
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=your-password-here

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=your-neo4j-password-here

# Application Settings
DEBUG=true
FRONTEND_URL=http://localhost:5173

# Optional API Keys (leave empty if not using)
OPENAI_API_KEY=
SENDGRID_API_KEY=       # Required for email verification in production; dev falls back to console logs
SENDGRID_FROM_EMAIL=noreply@innonet.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Error Tracking (production)
# Create a project at https://sentry.io, copy the DSN from Settings > Projects > DSN
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
